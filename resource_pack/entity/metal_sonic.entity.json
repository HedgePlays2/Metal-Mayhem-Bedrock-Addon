{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "hedge:metal_sonic",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/metal_sonic"
      },
      "geometry": {
        "default": "geometry.metal_sonic"
      },
      "render_controllers": [
        "controller.render.metal_sonic"
      ],
      "spawn_egg": {
        "base_color": "#167ac6",
        "overlay_color": "#e52d32"
      },
      "animations": {
        "idle": "animation.metal_sonic.idle",
        "walk": "animation.metal_sonic.walk",
        "attack": "animation.metal_sonic.attack"
      },
      "scripts": {
        "animate": [
          "idle",
          [
            "walk",
            "query.modified_move_speed > 0.05"
          ],
          [
            "attack",
            "query.is_attacking"
          ]
        ]
      }
    }
  }
}
